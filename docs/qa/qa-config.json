    "release": {
      "pot": "languages/wb-gamification.pot",
      "domain": "wb-gamification",
      "build_scripts": [
        "bin/build-release.sh"
      ],
      "excluded": [
        "bin/",
        "tests/",
        "docs/",
        "audit/",
        "plan/",
        "sdk/",
        "examples/",
        "node_modules/",
        "dist/"
      ],
      "allow_refs": [
        "__DIR__ . '/vendor/autoload.php'",
        "'audit/openapi.json'",
        "'audit/.last-scale-pass.json'"
      ],
      "allow_refs_reason": "The EDD SDK's own libs/.../edd-sl-sdk/vendor/ ships (only the top-level /vendor is excluded); the two audit/ paths are where developer-only WP-CLI commands (openapi export, scale benchmark) write their reports."
    },
    "static": [
      {
        "id": "i18n-json-keyed-to-scripts",
        "run": "php -r '$h=[];foreach(array(\"build\",\"assets/js\") as $d){if(!is_dir($d)){continue;}foreach(new RecursiveIteratorIterator(new RecursiveDirectoryIterator($d,FilesystemIterator::SKIP_DOTS)) as $f){$f=(string)$f;if(substr($f,-3)===\".js\"){$h[md5(preg_replace(\"/\\\\.min\\\\.js$/\",\".js\",$f))]=1;}}}$bad=0;foreach(glob(\"languages/*.json\") as $j){if(!preg_match(\"/-([a-f0-9]{32})\\\\.json$/\",$j,$m)||!isset($h[$m[1]])){echo \"not keyed to a shipped script: $j\\n\";$bad++;}}exit($bad?1:0);' 2>/dev/null"
      }
    ]
  }
