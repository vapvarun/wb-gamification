msgstr ""
"Assegnato una volta per quiz, quando un membro lo supera. I tentativi "
"falliti e le ripetizioni non assegnano nulla."

#: integrations/learnomy.php:88 src/Engine/Registry.php:851
msgid "Complete a course"
msgstr "Completare un corso"

