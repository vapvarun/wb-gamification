msgstr "Noms d’utilisateur, e-mails ou ID"

#: src/Admin/SettingsPage.php:2401
msgid "e.g. supportbot, qa@example.com, 42"
msgstr "p. ex. supportbot, qa@example.com, 42"

#: src/Admin/SettingsPage.php:2403
msgid "Unrecognized entries are dropped on save. The saved list shows the resolved usernames."
msgstr "Les entrées non reconnues sont écartées à l’enregistrement. La liste enregistrée affiche les noms d’utilisateur correspondants."

