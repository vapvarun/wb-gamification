#: integrations/buddynext.php:43 src/Engine/Registry.php:811
msgid "Create a post"
msgstr "Créer une publication"

#: integrations/buddynext.php:44
msgid "Awarded each time a member creates a post. Daily cap prevents farming."
msgstr "Attribué chaque fois qu’un membre crée une publication. Un plafond quotidien empêche les abus."

#: integrations/buddynext.php:82
msgid "Share a post"
msgstr "Partager une publication"

#: integrations/buddynext.php:83
msgid "Awarded when a member shares an existing post. Daily cap limits farming."
msgstr "Attribué lorsqu’un membre partage une publication existante. Un plafond quotidien limite les abus."

