#: src/Blocks/badge-showcase/block.json
msgctxt "block description"
msgid "Display earned badges for a member. Optionally shows locked badges greyed out."
msgstr "Muestra las insignias conseguidas por un miembro. Opcionalmente, muestra las insignias bloqueadas en gris."

#: src/Blocks/challenges/block.json
msgctxt "block description"
msgid "Display active gamification challenges with current user's progress."
msgstr "Muestra los desafíos de gamificación activos con el progreso del usuario actual."

#: src/Blocks/cohort-rank/block.json
msgctxt "block description"
msgid "Display the current member's cohort league standing — tier, rank within cohort, points this week."
msgstr "Muestra la posición del miembro actual en la liga de su cohorte: división, puesto en la cohorte y puntos de esta semana."

#: src/Blocks/community-challenges/block.json
msgctxt "block description"
msgid "Display active community challenges (Pokémon GO style — global counter accumulates as everyone contributes)."
msgstr "Muestra los desafíos comunitarios activos (al estilo de Pokémon GO: un contador global que suma lo que aporta cada persona)."

#: src/Blocks/daily-bonus/block.json
msgctxt "block description"
msgid "Show the member's current login streak and the points they'll get for logging in today + the upcoming tier ladder."
msgstr "Muestra la racha de inicios de sesión del miembro, los puntos que conseguirá por iniciar sesión hoy y la escala de los siguientes tramos."

#: src/Blocks/earning-guide/block.json
msgctxt "block description"
msgid "Show members how to earn points — lists all enabled actions with their point values, grouped by category."
msgstr "Muestra a los miembros cómo ganar puntos: lista todas las acciones habilitadas con su valor en puntos, agrupadas por categoría."

#: src/Blocks/give-kudos/block.json
msgctxt "block description"
msgid "Front-end form that lets a logged-in member send kudos to another member via the REST API."
msgstr "Formulario de la parte pública que permite a un miembro con la sesión iniciada enviar kudos a otro miembro."

#: src/Blocks/hub/block.json
msgctxt "block description"
msgid "Member gamification dashboard — stats, badges, challenges, leaderboard, and more in a connected card layout with slide-in detail panels."
msgstr "Panel de gamificación del miembro: estadísticas, insignias, desafíos, clasificación y más, en un diseño de tarjetas conectadas con paneles de detalle laterales."

#: src/Blocks/kudos-feed/block.json
msgctxt "block description"
msgid "Display a live feed of recent peer kudos and let members send kudos directly from the block."
msgstr "Muestra un flujo en directo de los kudos recientes entre miembros y permite enviar kudos desde el propio bloque."

#: src/Blocks/leaderboard/block.json
msgctxt "block description"
msgid "Display a points leaderboard with configurable period and limit."
msgstr "Muestra una clasificación de puntos con periodo y límite configurables."

#: src/Blocks/level-progress/block.json
msgctxt "block description"
msgid "Show a member's current level, progress bar, and points to next level."
msgstr "Muestra el nivel actual de un miembro, la barra de progreso y los puntos que faltan para el siguiente nivel."

#: src/Blocks/member-points/block.json
msgctxt "block description"
msgid "Display a member's current points total and level progress."
msgstr "Muestra el total actual de puntos de un miembro y el progreso de nivel."

#: src/Blocks/points-history/block.json
msgctxt "block description"
msgid "Show a member's recent point transactions with action labels and dates."
msgstr "Muestra los movimientos de puntos recientes de un miembro, con el nombre de la acción y la fecha."

#: src/Blocks/redemption-store/block.json
msgctxt "block description"
msgid "Member-facing rewards catalog. Lists active redemption items with point cost, stock, and a Redeem button. Pilot for the Wbcom Block Quality Standard."
msgstr "Catálogo de recompensas para los miembros. Lista las recompensas activas con su coste en puntos, existencias y un botón Canjear. Piloto del estándar de calidad de bloques de Wbcom."

#: src/Blocks/streak/block.json
msgctxt "block description"
msgid "Show a member's current activity streak, longest streak, and optional contribution heatmap."
msgstr "Muestra la racha de actividad actual de un miembro, su racha más larga y, opcionalmente, un mapa de calor de contribuciones."

#: src/Blocks/submit-achievement/block.json
msgctxt "block description"
msgid "Lets members submit an achievement (text + optional URL) for admin approval. Approved submissions fire the standard earning event."
msgstr "Permite a los miembros enviar un logro (texto y una URL opcional) para que lo apruebe el administrador. Las propuestas aprobadas activan la acción de puntos estándar."

#: src/Blocks/top-members/block.json
msgctxt "block description"
msgid "Highlight top-ranked members with avatars, points, level, and badge count."
msgstr "Destaca a los miembros con mejor puesto, e incluye avatar, puntos, nivel y número de insignias."

#: src/Blocks/user-status-bar/block.json
msgctxt "block description"
msgid "Sticky / floating bar that shows the logged-in member's points, level, badges and streak. Updates live via the heartbeat realtime channel."
msgstr "Barra fija o flotante que muestra los puntos, el nivel, las insignias y la racha del miembro con la sesión iniciada. Se actualiza en directo por el canal Heartbeat."

#: src/Blocks/year-recap/block.json
msgctxt "block description"
msgid "A shareable Spotify-Wrapped-style recap card showing a member's highlights for the year."
msgstr "Una tarjeta compartible, al estilo de Spotify Wrapped, con lo más destacado del año de un miembro."

